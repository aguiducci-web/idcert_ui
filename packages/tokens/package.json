{
  "name": "@idcert/tokens",
  "version": "0.0.0",
  "description": "Design tokens for @idcert/ui (colors, spacing, typography)",
  "license": "MIT",
  "author": "idcert.io <aguiducci@idcert.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idcert/ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/idcert/ui#readme",
  "bugs": "https://github.com/idcert/ui/issues",
  "keywords": [
    "design-tokens",
    "css-variables",
    "design-system",
    "idcert"
  ],
  "type": "module",
  "sideEffects": [
    "dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@idcert/tsconfig": "workspace:*",
    "@types/node": "^22",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
