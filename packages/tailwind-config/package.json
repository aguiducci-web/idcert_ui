{
  "name": "@idcert/tailwind-config",
  "version": "0.1.0",
  "description": "Shared Tailwind preset for @idcert/ui consumers",
  "license": "MIT",
  "author": "idcert.io <aguiducci@idcert.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idcert/ui.git",
    "directory": "packages/tailwind-config"
  },
  "homepage": "https://github.com/idcert/ui#readme",
  "bugs": "https://github.com/idcert/ui/issues",
  "keywords": [
    "tailwindcss",
    "tailwind-preset",
    "design-system",
    "idcert"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4"
  },
  "devDependencies": {
    "@idcert/tsconfig": "workspace:*",
    "tailwindcss": "^3.4.14",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  }
}
