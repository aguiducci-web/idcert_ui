{
  "name": "@idcert/ui",
  "version": "0.0.0",
  "description": "idcert.io React component library",
  "license": "MIT",
  "author": "idcert.io <aguiducci@idcert.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idcert/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/idcert/ui#readme",
  "bugs": "https://github.com/idcert/ui/issues",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "tailwindcss",
    "idcert"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "next": ">=14",
    "next-themes": ">=0.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@idcert/tokens": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@idcert/tailwind-config": "workspace:*",
    "@idcert/tsconfig": "workspace:*",
    "@storybook/react": "^8.3.6",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.4",
    "jsdom": "^25.0.1",
    "next": "^14.2.16",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
