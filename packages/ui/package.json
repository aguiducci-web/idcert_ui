{
  "name": "@idcert/ui",
  "version": "1.0.0",
  "description": "idcert.io React component library",
  "license": "MIT",
  "author": "idcert.io <aguiducci@idcert.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idcert/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/idcert/ui#readme",
  "bugs": "https://github.com/idcert/ui/issues",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "tailwindcss",
    "idcert"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components/*/examples": {
      "types": "./dist/components/*/*.examples.d.ts",
      "import": "./dist/components/*/*.examples.js",
      "require": "./dist/components/*/*.examples.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@idcert/tailwind-config": "workspace:*",
    "date-fns": "^3 || ^4",
    "next": ">=14",
    "next-themes": ">=0.3",
    "react": ">=18",
    "react-day-picker": "^9",
    "react-dom": ">=18",
    "react-hook-form": "^7",
    "zod": "^3"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-hook-form": {
      "optional": false
    },
    "zod": {
      "optional": false
    },
    "date-fns": {
      "optional": false
    },
    "react-day-picker": {
      "optional": false
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@idcert/tokens": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3",
    "@idcert/tsconfig": "workspace:*",
    "@storybook/react": "^8.3.6",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.4",
    "date-fns": "^4.1.0",
    "glob": "^13.0.6",
    "jsdom": "^25.0.1",
    "next": "^14.2.16",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "^3.25.76"
  }
}