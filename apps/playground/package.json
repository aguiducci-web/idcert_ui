{
  "name": "@idcert/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next .turbo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "pnpm gen:props && pnpm gen:examples-source && pnpm gen:search-index",
    "gen:props": "tsx scripts/generate-props.ts",
    "gen:examples-source": "tsx scripts/extract-examples-source.ts",
    "gen:search-index": "tsx scripts/generate-search-index.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3",
    "@idcert/tailwind-config": "workspace:*",
    "@idcert/tokens": "workspace:*",
    "@idcert/ui": "workspace:*",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.4",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@types/mdx": "^2.0.13",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.14.0",
    "next": "^14.2.16",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^9",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^2.5.4",
    "zod": "^3"
  },
  "devDependencies": {
    "@idcert/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "react-docgen-typescript": "^2.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
